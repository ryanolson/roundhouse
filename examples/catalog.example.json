{
  "$comment": [
    "EXAMPLE ONLY. Every price below is a placeholder, not a quote.",
    "Provider rate cards change; copy this file, then replace each figure with the",
    "current published rate for the model you are actually calling. Roundhouse",
    "reports savings against these numbers, so a stale rate card does not produce a",
    "slightly wrong dashboard -- it produces a confidently wrong one.",
    "Point ROUNDHOUSE_CATALOG at your copy."
  ],

  "models": [
    {
      "provider": "anthropic",
      "model": "REPLACE-with-the-model-you-call",
      "wire_protocol": "anthropic_messages",
      "cache_model": { "kind": "deterministic", "ttl_ms": 300000 },
      "pricing": {
        "input_per_mtok_usd": 0.0,
        "cached_input_per_mtok_usd": 0.0,
        "cache_write_per_mtok_usd": 0.0,
        "output_per_mtok_usd": 0.0
      },
      "quality_prior": 0.95,
      "base_ttft_ms": 350.0,
      "ttft_ms_per_uncached_token": 0.002
    },
    {
      "provider": "openai",
      "model": "REPLACE-with-the-model-you-call",
      "wire_protocol": "openai_responses",
      "cache_model": {
        "kind": "inactivity_decay",
        "half_life_ms": 300000,
        "max_ttl_ms": 3600000,
        "min_prefix_tokens": 1024
      },
      "pricing": {
        "input_per_mtok_usd": 0.0,
        "cached_input_per_mtok_usd": 0.0,
        "cache_write_per_mtok_usd": 0.0,
        "output_per_mtok_usd": 0.0
      },
      "quality_prior": 0.9,
      "base_ttft_ms": 300.0,
      "ttft_ms_per_uncached_token": 0.0015
    }
  ],

  "local_quality": {
    "REPLACE-with-your-local-model": 0.62
  },

  "correlaries": [
    {
      "local_model": "REPLACE-with-your-local-model",
      "provider": "openai",
      "model": "REPLACE-with-the-model-you-call",
      "note": "Replace this note with why. It is shown verbatim on the dashboard, because a reader deciding whether to trust the savings figure is really deciding whether to trust this sentence."
    }
  ],

  "default_local_quality": 0.5,
  "capability_band": 0.10
}
